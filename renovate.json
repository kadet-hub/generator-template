{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pep723": {
    "managerFilePatterns": [
      "/^scaffold$/"
    ]
  },
  "packageRules": [
    {
      "description": "Runners stay on ubuntu-24.04, the runner the registry gate's tooling that ./check runs is tested on",
      "matchDatasources": [
        "github-runners"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "24.04"
    }
  ]
}
