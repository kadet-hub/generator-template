{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "pep723": {
    "managerFilePatterns": [
      "/^scaffold$/"
    ]
  },
  "packageRules": [
    {
      "description": "Runners stay on ubuntu-24.04, the runner the registry gate's tooling that ./check runs is tested on",
      "matchDatasources": [
        "github-runners"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "24.04"
    },
    {
      "description": "Renovate merges its own pull request once every check passed; majors wait for a maintainer",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "a digest update of an action under the same version is a moved tag",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": false
    }
  ],
  "platformAutomerge": false
}
